{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "p00.scheduler_proposal.v1"
    },
    "status": {
      "const": "CANDIDATE_NOT_AUTHORITY"
    },
    "baseline_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "policy_binding": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "action": {
      "enum": [
        "PROPOSE_PACKAGE",
        "REENTRY",
        "WAIT",
        "PREPARE_FORECAST"
      ]
    },
    "priority_class": {
      "enum": [
        "SAFETY_GOVERNANCE",
        "UNFINISHED",
        "RESULT_REVIEW_INTEGRATION",
        "NEW_WORK"
      ]
    },
    "upstream_route": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "dispatch_mode": {
      "enum": [
        "MANUAL",
        "CONTROLLED_AUTO"
      ]
    },
    "capacity_route": {
      "enum": [
        "ALLOW_WITH_WATCH",
        "CONTROLLED_AUTO_CAPACITY_FIT",
        "DENIED",
        "UNKNOWN"
      ]
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exact_authority": {
          "type": "boolean"
        },
        "dependencies_ready": {
          "type": "boolean"
        },
        "lane_permits": {
          "type": "boolean"
        },
        "writer_available": {
          "type": "boolean"
        },
        "provider_available": {
          "type": "boolean"
        },
        "scope_ready": {
          "type": "boolean"
        },
        "external_clear": {
          "type": "boolean"
        },
        "forecast_known": {
          "type": "boolean"
        },
        "promotion_ready": {
          "type": "boolean"
        }
      },
      "required": [
        "exact_authority",
        "dependencies_ready",
        "lane_permits",
        "writer_available",
        "provider_available",
        "scope_ready",
        "external_clear",
        "forecast_known",
        "promotion_ready"
      ]
    },
    "selected_package": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        {
          "type": "null"
        }
      ]
    },
    "next_wake_utc": {
      "type": "string",
      "format": "date-time"
    },
    "wake_reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "schedule_generation": {
      "type": "integer",
      "minimum": 1
    },
    "dedupe_subject": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "relevant_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "lifecycle_generation": {
      "type": "integer",
      "minimum": 0
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ]
      }
    },
    "execution_eligible": {
      "const": false
    },
    "side_effects": {
      "const": "NONE"
    },
    "limitations": {
      "const": "Proposal only; revalidate accepted route, authority and source before any effect."
    }
  },
  "required": [
    "schema_version",
    "status",
    "baseline_sha",
    "policy_binding",
    "action",
    "priority_class",
    "upstream_route",
    "dispatch_mode",
    "capacity_route",
    "gates",
    "selected_package",
    "next_wake_utc",
    "wake_reason",
    "schedule_generation",
    "dedupe_subject",
    "relevant_revision",
    "lifecycle_generation",
    "evidence_refs",
    "execution_eligible",
    "side_effects",
    "limitations"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "if": {
        "properties": {
          "action": {
            "const": "PROPOSE_PACKAGE"
          }
        }
      },
      "then": {
        "properties": {
          "priority_class": {
            "const": "NEW_WORK"
          },
          "selected_package": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "gates": {
            "properties": {
              "exact_authority": {
                "const": true
              },
              "dependencies_ready": {
                "const": true
              },
              "lane_permits": {
                "const": true
              },
              "writer_available": {
                "const": true
              },
              "provider_available": {
                "const": true
              },
              "scope_ready": {
                "const": true
              },
              "external_clear": {
                "const": true
              },
              "forecast_known": {
                "const": true
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "dispatch_mode": {
                  "const": "MANUAL"
                }
              }
            },
            "then": {
              "properties": {
                "capacity_route": {
                  "const": "ALLOW_WITH_WATCH"
                },
                "upstream_route": {
                  "const": "READY_FOR_MANUAL_DISPATCH"
                }
              }
            },
            "else": {
              "properties": {
                "capacity_route": {
                  "const": "CONTROLLED_AUTO_CAPACITY_FIT"
                },
                "upstream_route": {
                  "const": "CONTROLLED_AUTO_DISPATCH_ELIGIBLE"
                },
                "gates": {
                  "properties": {
                    "promotion_ready": {
                      "const": true
                    }
                  }
                }
              }
            }
          }
        ]
      },
      "else": {
        "properties": {
          "selected_package": {
            "type": "null"
          }
        }
      }
    }
  ]
}
