{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "p00.package.v1"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "package_id": {
          "type": "string",
          "pattern": "^P[0-9]{2}$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "baseline_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "deliverable_weights": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "required": [
        "package_id",
        "revision",
        "baseline_sha",
        "requirement_ids",
        "deliverable_weights"
      ]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parent_wave_grant": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "path",
                "sha256"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "exact_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "protected_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "allowed_side_effects": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "READ",
              "SCOPE_WRITE",
              "LOCAL_TEST",
              "GIT_COMMIT",
              "GIT_PUSH"
            ]
          }
        },
        "correction_budget": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      },
      "required": [
        "parent_wave_grant",
        "exact_scope",
        "protected_scope",
        "allowed_side_effects",
        "correction_budget"
      ]
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "DRAFT",
            "DEFINED_CANDIDATE"
          ]
        },
        "owners": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "input_output_schemas": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "state_transitions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "transaction_boundary": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_and_recovery": {
          "type": "string",
          "minLength": 1
        },
        "error_and_unknown_semantics": {
          "type": "string",
          "minLength": 1
        },
        "compatibility_rules": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "public_semantic_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "status",
        "owners",
        "input_output_schemas",
        "state_transitions",
        "transaction_boundary",
        "idempotency_and_recovery",
        "error_and_unknown_semantics",
        "compatibility_rules",
        "public_semantic_gaps"
      ]
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "required_acceptances": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          }
        },
        "external_gates": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "parallel_or_parked_work": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "required_acceptances",
        "external_gates",
        "parallel_or_parked_work"
      ]
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "positive_examples": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "counterexamples": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "targeted_tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "integration_tests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "regression_impact_set": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "independent_review_scope": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "positive_examples",
        "counterexamples",
        "targeted_tests",
        "integration_tests",
        "regression_impact_set",
        "independent_review_scope"
      ]
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_artifacts": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "acceptance_checks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "stop_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        }
      },
      "required": [
        "evidence_artifacts",
        "acceptance_checks",
        "stop_conditions"
      ]
    }
  },
  "required": [
    "schema_version",
    "identity",
    "authority",
    "design",
    "dependencies",
    "verification",
    "completion"
  ]
}
